# Clé Google AI Studio (https://aistudio.google.com/apikey) : embeddings, réponse générée,
# juge des recherches et mode révision.
SEMANTICA_GEMINI_API_KEY=

# Token Hugging Face (https://huggingface.co/settings/tokens) avec le droit
# « Make calls to Inference Providers » : reranker et embeddings de comparaison (évaluation).
SEMANTICA_HF_TOKEN=
